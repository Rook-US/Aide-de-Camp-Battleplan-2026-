<Window x:Class="BattleplanADC.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aide-de-Camp — Battleplan" Width="1360" Height="880" MinWidth="1040" MinHeight="680" Background="#F2F5F7" Foreground="#172B38" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="#254A63"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#254A63"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/></Style>
    <Style x:Key="HeaderButton" TargetType="Button"><Setter Property="Background" Value="#DCECF4"/><Setter Property="Foreground" Value="#17384D"/><Setter Property="BorderBrush" Value="#DCECF4"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#172B38"/><Setter Property="BorderBrush" Value="#9AAEBB"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="4"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#172B38"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#172B38"/><Setter Property="Margin" Value="4,6"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#254A63"/><Setter Property="BorderBrush" Value="#D2DDE4"/><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="8"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#172B38"/></Style>
    <Style TargetType="TabItem"><Setter Property="Background" Value="#E3EBF0"/><Setter Property="Foreground" Value="#172B38"/><Setter Property="Padding" Value="12,8"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#172B38"/><Setter Property="BorderBrush" Value="#D2DDE4"/><Setter Property="HorizontalGridLinesBrush" Value="#D2DDE4"/><Setter Property="VerticalGridLinesBrush" Value="#D2DDE4"/><Setter Property="RowBackground" Value="#FFFFFF"/><Setter Property="AlternatingRowBackground" Value="#F2F6F8"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
  </Window.Resources>
  <DockPanel Background="#F2F5F7">
    <Border DockPanel.Dock="Top" Background="#17384D" Padding="12"><StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock Text="BATTLEPLAN  /  AIDE-DE-CAMP" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/><Button Style="{StaticResource HeaderButton}" Content="Browse .camp" Click="Open_Click"/><Button Style="{StaticResource HeaderButton}" Content="Save with backup" Click="Save_Click"/><TextBlock x:Name="CampaignLabel" Margin="18,0" VerticalAlignment="Center" Foreground="#E5EFF4"/></StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="Campaign" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="4,0,8,0"/><ComboBox x:Name="CampaignFilesBox" Width="290" DisplayMemberPath="Name"/><Button Style="{StaticResource HeaderButton}" Content="Open" Click="OpenSelected_Click"/><Button Style="{StaticResource HeaderButton}" Content="Refresh" Click="RefreshFiles_Click"/><CheckBox x:Name="ShowMoreToolsBox" Content="More tools" Foreground="#FFFFFF" Margin="14,6" Checked="ShowMoreTools_Changed" Unchecked="ShowMoreTools_Changed"/><TextBlock x:Name="SavePathLabel" Foreground="#CFDFE8" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    </StackPanel></Border>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Background="#DCE8EF" Foreground="#17384D" Padding="12" Text="Open a .camp file to begin."/>
    <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
      <Border Background="#FFFFFF" BorderBrush="#D2DDE4" BorderThickness="1" Margin="6" Padding="8" Grid.Column="0"><DockPanel>
        <TextBlock Text="YOUR ARMY" DockPanel.Dock="Top" Foreground="#254A63" FontWeight="Bold" Margin="2,0,0,6"/>
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" TextChanged="Search_Changed" ToolTip="Search names, IDs, and officers"/>
        <WrapPanel DockPanel.Dock="Top"><Button Content="Expand all" Click="ExpandAll_Click"/><Button Content="Collapse all" Click="CollapseAll_Click"/><Button Content="Edit name (F2)" Click="OobEditName_Click"/></WrapPanel>
        <Expander DockPanel.Dock="Top" Header="Select several units" Margin="4,4"><StackPanel><TextBlock Text="Ctrl picks units; Shift picks a range." Foreground="#415D6D" Margin="4"/><WrapPanel><Button Content="Select visible" Click="SelectVisible_Click"/><Button Content="Select this group" Click="SelectBranch_Click"/><Button Content="Clear" Click="ClearOobSelection_Click"/></WrapPanel></StackPanel></Expander>
        <Expander DockPanel.Dock="Top" Header="Set command level or number" Margin="4,4"><StackPanel><TextBlock Text="Choose one or more units in the army list first." Foreground="#415D6D" Margin="4"/><WrapPanel><ComboBox x:Name="OobTierBox" Width="130" SelectedIndex="0"><ComboBoxItem Content="Command level..."/><ComboBoxItem Content="Army"/><ComboBoxItem Content="Corps"/><ComboBoxItem Content="Division"/><ComboBoxItem Content="Regiment"/><ComboBoxItem Content="Battalion"/><ComboBoxItem Content="Company"/><ComboBoxItem Content="Battery"/><ComboBoxItem Content="Other"/></ComboBox><ComboBox x:Name="OobBranchBox" Width="122" SelectedIndex="0"><ComboBoxItem Content="Unit type..."/><ComboBoxItem Content="Headquarters"/><ComboBoxItem Content="Infantry"/><ComboBoxItem Content="Artillery"/><ComboBoxItem Content="Anti-Tank"/><ComboBoxItem Content="Engineers"/><ComboBoxItem Content="Armor"/><ComboBoxItem Content="Cavalry"/><ComboBoxItem Content="Other"/></ComboBox><Button Content="Set level + type" Click="OobSetTier_Click"/></WrapPanel><WrapPanel><TextBlock Text="Number" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="OobNumberBox" Width="65"/><Button Content="Use this number" Click="OobSetNumber_Click"/><TextBlock x:Name="OobChoiceLabel" Foreground="#415D6D" VerticalAlignment="Center" Margin="7"/></WrapPanel></StackPanel></Expander>
        <TextBlock DockPanel.Dock="Top" Text="Double click or press F2 to rename a unit." Foreground="#415D6D" FontSize="11" Margin="4,0,0,4"/>
        <TextBlock x:Name="CountLabel" DockPanel.Dock="Bottom" Margin="6" Foreground="#415D6D"/>
        <TreeView x:Name="UnitTree" Background="#FFFFFF" Foreground="#172B38" BorderThickness="0" PreviewMouseLeftButtonDown="UnitTree_PreviewMouseLeftButtonDown" PreviewKeyDown="UnitTree_PreviewKeyDown" SelectedItemChanged="UnitTree_SelectedItemChanged"/>
      </DockPanel></Border>
      <TabControl x:Name="MainTabs" Grid.Column="1" Margin="6" SelectedIndex="1">
        <TabItem Header="One regiment"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
          <TextBlock Text="RENAME ONE REGIMENT’S UNITS" FontWeight="Bold" Foreground="#254A63" FontSize="16"/>
          <TextBlock Text="Choose a regiment in the army list, then show its units. Review the names in the table and apply the checked ones." TextWrapping="Wrap" Margin="4,10" Foreground="#415D6D"/>
          <TextBlock x:Name="BattalionCommandLabel" Text="Selected command: none" FontWeight="SemiBold" Margin="4,8"/>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Regiment number" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="BattalionRegimentNumber" Width="78" ToolTip="For 25IR, enter 25"/></StackPanel>
          <Expander Header="Change the name format" Margin="4,8"><StackPanel><TextBlock Text="Use this if the suggested names do not match your style. Example: 1-25 INF." TextWrapping="Wrap" Foreground="#415D6D"/><TextBox x:Name="BattalionPattern" Width="250" HorizontalAlignment="Left" Text="{}{slot}-{regiment} {suffix}" ToolTip="{}{slot} is the unit number, {regiment} is the regiment number, {suffix} is the unit type"/></StackPanel></Expander>
          <StackPanel Orientation="Horizontal" Margin="0,8"><Button Content="Show regiment units" Click="BattalionLoad_Click"/><Button Content="Update names" Click="BattalionPreview_Click"/><Button Content="Apply checked names" Click="BattalionApply_Click"/></StackPanel>
          <TextBlock x:Name="BattalionMessage" TextWrapping="Wrap" Foreground="#254A63" Margin="4,8"/>
          <DataGrid x:Name="BattalionGrid" Height="400" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" HeadersVisibility="Column"><DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Use" Binding="{Binding Use, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
            <DataGridTextColumn Header="Current name" Binding="{Binding Before}" IsReadOnly="True" Width="155"/>
            <DataGridTextColumn Header="Unit type" Binding="{Binding GameType}" IsReadOnly="True" Width="150"/>
            <DataGridTextColumn Header="No." Binding="{Binding Slot, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
            <DataGridTextColumn Header="Suffix" Binding="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
            <DataGridTextColumn Header="Proposed name (editable)" Binding="{Binding Proposed, UpdateSourceTrigger=PropertyChanged}" Width="205"/>
          </DataGrid.Columns></DataGrid>
          <TextBlock Text="Edit the suggested names directly in the table. Apply stages them; Save with backup writes the campaign." Foreground="#415D6D" TextWrapping="Wrap" Margin="4,10"/>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Whole army"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
          <TextBlock Text="RENAME YOUR ARMY" FontWeight="Bold" Foreground="#254A63" FontSize="16"/>
          <TextBlock Text="Set each command’s level on the left when needed. Then preview names, edit any suggestion, and apply the checked rows." TextWrapping="Wrap" Foreground="#415D6D" Margin="4,10"/>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Rename" VerticalAlignment="Center" Margin="4"/><ComboBox x:Name="MassScopeBox" Width="230" SelectedIndex="0"><ComboBoxItem Content="Entire army"/><ComboBoxItem Content="Selected group and its units"/></ComboBox></StackPanel>
          <Expander Header="Change battalion name format" Margin="4,8"><StackPanel><TextBlock Text="The starting format makes names like 1-25 INF. Edit any suggestion in the table below." TextWrapping="Wrap" Foreground="#415D6D"/><TextBox x:Name="MassChildPattern" Width="250" HorizontalAlignment="Left" Text="{}{slot}-{regiment} {suffix}" ToolTip="{}{slot} is the unit number, {regiment} is the regiment number, {suffix} is the unit type"/></StackPanel></Expander>
          <StackPanel Orientation="Horizontal" Margin="0,8"><Button Content="Preview names" Click="MassPreview_Click"/><Button Content="Apply checked names" Click="MassApply_Click"/></StackPanel>
          <TextBlock Text="Preview saves chosen numbers so future formations will not reuse them. Apply stages the checked names; Save with backup writes the campaign." TextWrapping="Wrap" Foreground="#415D6D" Margin="4"/>
          <TextBlock x:Name="MassMessage" TextWrapping="Wrap" Foreground="#254A63" Margin="4,10"/>
          <DataGrid x:Name="MassGrid" Height="420" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" HeadersVisibility="Column"><DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Use" Binding="{Binding Use, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
            <DataGridTextColumn Header="Level" Binding="{Binding Tier}" IsReadOnly="True" Width="78"/>
            <DataGridTextColumn Header="Current name" Binding="{Binding Current}" IsReadOnly="True" Width="155"/>
            <DataGridTextColumn Header="Proposed name (editable)" Binding="{Binding Proposed, UpdateSourceTrigger=PropertyChanged}" Width="205"/>
            <DataGridTextColumn Header="Note" Binding="{Binding Reason}" IsReadOnly="True" Width="220"/>
          </DataGrid.Columns></DataGrid>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="AdvancedTab" Header="Patterns and filters" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
          <TextBlock Text="CLASSIFY AND NAME UNITS" FontWeight="Bold" Foreground="#254A63"/>
          <TextBlock Text="Battleplan's Headquarters type has no fixed command tier. Select rows (Ctrl or Shift for a batch), assign tier and branch, and choose whether to rename them. Choices are saved in an editor catalog for this campaign." TextWrapping="Wrap" Margin="4,8" Foreground="#415D6D"/>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Show" VerticalAlignment="Center"/><ComboBox x:Name="CatalogFilter" Width="140" SelectionChanged="CatalogFilter_Changed" SelectedIndex="0"><ComboBoxItem Content="All units"/><ComboBoxItem Content="Headquarters"/><ComboBoxItem Content="Duplicate names"/><ComboBoxItem Content="Unclassified"/></ComboBox><ComboBox x:Name="CatalogTypeFilter" Width="150" SelectionChanged="CatalogFilter_Changed"/><TextBlock Text="Tier" VerticalAlignment="Center"/><ComboBox x:Name="BatchTier" Width="110"><ComboBoxItem Content="Army"/><ComboBoxItem Content="Corps"/><ComboBoxItem Content="Division"/><ComboBoxItem Content="Regiment"/><ComboBoxItem Content="Battalion"/><ComboBoxItem Content="Company"/><ComboBoxItem Content="Battery"/><ComboBoxItem Content="Other"/></ComboBox><TextBlock Text="Branch" VerticalAlignment="Center"/><ComboBox x:Name="BatchBranch" Width="115"><ComboBoxItem Content="Infantry"/><ComboBoxItem Content="Artillery"/><ComboBoxItem Content="Anti-Tank"/><ComboBoxItem Content="Engineers"/><ComboBoxItem Content="Armor"/><ComboBoxItem Content="Cavalry"/><ComboBoxItem Content="Headquarters"/><ComboBoxItem Content="Other"/></ComboBox></StackPanel>
          <StackPanel Orientation="Horizontal"><Button Content="Assign tier + branch to selected" Click="CatalogAssign_Click"/><Button Content="Modify selected" Click="CatalogInclude_Click"/><Button Content="Do not modify selected" Click="CatalogExclude_Click"/><Button Content="Clear policy" Click="CatalogDefault_Click"/></StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Selected command number" VerticalAlignment="Center"/><TextBox x:Name="CatalogNumber" Width="60"/><Button Content="Set number for one selected unit" Click="CatalogNumber_Click"/><TextBlock Text="Use for designators such as 25IR." Foreground="#415D6D" VerticalAlignment="Center"/></StackPanel>
          <DataGrid x:Name="CatalogGrid" Height="255" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="CatalogGrid_SelectionChanged" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="160"/><DataGridTextColumn Header="Game type" Binding="{Binding GameType}" Width="120"/><DataGridTextColumn Header="Parent" Binding="{Binding Parent}" Width="130"/><DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="85"/><DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="90"/><DataGridTextColumn Header="No." Binding="{Binding Number}" Width="50"/><DataGridTextColumn Header="Policy" Binding="{Binding Policy}" Width="85"/><DataGridTextColumn Header="Game unit ID" Binding="{Binding Id}" Width="230"/></DataGrid.Columns></DataGrid>
          <TextBlock Text="NAMING SCHEME" FontWeight="Bold" Foreground="#254A63" Margin="4,14,4,4"/>
          <TextBlock Text="Choose a tier and branch above. Enter a name example to suggest a pattern, then edit the pattern if needed. Only user-entered names are examples; original game names are ignored." TextWrapping="Wrap" Foreground="#415D6D" Margin="4"/>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Examples" VerticalAlignment="Center"/><TextBox x:Name="SchemeExample" Width="200" Height="48" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><Button Content="Infer pattern" Click="SchemeInfer_Click"/><Button Content="Use selected user names" Click="SchemeUseSelected_Click"/></StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Pattern" VerticalAlignment="Center"/><TextBox x:Name="SchemePattern" Width="260"/><TextBlock Text="Start" VerticalAlignment="Center"/><TextBox x:Name="SchemeStart" Text="1" Width="55"/><ComboBox x:Name="SchemeSequence" Width="125" SelectedIndex="0"><ComboBoxItem Content="Global"/><ComboBoxItem Content="Per parent"/></ComboBox><Button Content="Save scheme" Click="SchemeSave_Click"/></StackPanel>
          <TextBlock Text="Tokens: {n} number, {n:ordinal} 1st/2nd, {slot} OOB position among selected siblings, {parentNumber} numbered ancestor. Example: {slot}-{parentNumber} INF." Foreground="#415D6D" TextWrapping="Wrap" Margin="4"/>
          <TextBlock x:Name="SchemeMessage" Foreground="#254A63" TextWrapping="Wrap" Margin="4"/>
          <StackPanel Orientation="Horizontal"><Button Content="Preview army names" Click="CatalogPreview_Click"/><Button Content="Apply preview" Click="CatalogApply_Click"/></StackPanel>
          <TextBlock x:Name="CatalogStatus" Foreground="#415D6D" TextWrapping="Wrap" Margin="4"/>
          <DataGrid x:Name="CatalogPreviewGrid" Height="210" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Tier" Binding="{Binding Tier}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="Branch" Binding="{Binding Branch}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="Current" Binding="{Binding Before}" IsReadOnly="True" Width="170"/><DataGridTextColumn Header="Proposed (editable)" Binding="{Binding After, UpdateSourceTrigger=PropertyChanged}" Width="200"/></DataGrid.Columns></DataGrid>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="One unit"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
          <TextBlock Text="SELECTED UNIT" FontWeight="Bold" Foreground="#254A63"/>
          <TextBlock x:Name="SelectedPath" TextWrapping="Wrap" Margin="4,10"/>
          <TextBlock x:Name="UnitDetails" TextWrapping="Wrap" Margin="4,4,4,14" Foreground="#415D6D"/>
          <TextBlock Text="Unit name"/>
          <TextBox x:Name="UnitNameBox"/>
          <StackPanel Orientation="Horizontal"><Button Content="Apply unit name" Click="ApplyUnit_Click"/><Button Content="Clear override" Click="ClearUnit_Click"/></StackPanel>
          <TextBlock Margin="4,18,4,4" TextWrapping="Wrap" Foreground="#415D6D" Text="Save with backup writes this name to the campaign. Keep Battleplan closed while saving, then check the result in game."/>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="OOB naming" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
          <TextBlock Text="REGIMENT-BASED NAMING" FontWeight="Bold" Foreground="#254A63"/>
          <TextBlock Text="Edit each regiment number below, then preview. Child names use their position and role: infantry 1–3, artillery 4, AT/TD 5, engineers 6, and additional detachments 7 onward." TextWrapping="Wrap" Margin="4,8" Foreground="#415D6D"/>
          <Expander x:Name="OobSetupExpander" Header="Regiment setup" IsExpanded="True" Margin="4,8"><StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Scope" VerticalAlignment="Center" Margin="4"/><ComboBox x:Name="OobScopeBox" Width="230" SelectedIndex="0"><ComboBoxItem Content="All included regiments"/><ComboBoxItem Content="Selected branch only"/></ComboBox><CheckBox x:Name="RenameRegimentsBox" Content="Rename regiment commands" IsChecked="True"/><CheckBox x:Name="IncludeOtherBox" Content="Name other detachments"/></StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Roles" VerticalAlignment="Center" Margin="4"/><CheckBox x:Name="OobInfantryBox" Content="Infantry" IsChecked="True"/><CheckBox x:Name="OobArtilleryBox" Content="Artillery" IsChecked="True"/><CheckBox x:Name="OobAntiTankBox" Content="AT / TD" IsChecked="True"/><CheckBox x:Name="OobEngineerBox" Content="Engineers" IsChecked="True"/></StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Other detachment suffix" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="OtherSuffixBox" Width="76" Text="DET"/><TextBlock Text="AT/TD and ENG/ARMENG can be edited in the preview." VerticalAlignment="Center" Foreground="#415D6D" Margin="8"/></StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Regiment candidates" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4"/><Button Content="Add selected command as regiment" Click="AddSelectedRegiment_Click"/></StackPanel>
          <DataGrid x:Name="RegimentGrid" Height="220" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Use" Binding="{Binding Include}" Width="48"/>
            <DataGridTextColumn Header="Current regiment" Binding="{Binding Current}" IsReadOnly="True" Width="165"/>
            <DataGridTextColumn Header="Parent command" Binding="{Binding Command}" IsReadOnly="True" Width="175"/>
            <DataGridTextColumn Header="No." Binding="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
            <DataGridTextColumn Header="Suffix" Binding="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
            <DataGridTextColumn Header="Children" Binding="{Binding Children}" IsReadOnly="True" Width="70"/>
          </DataGrid.Columns></DataGrid>
          </StackPanel></Expander>
          <StackPanel Orientation="Horizontal" Margin="0,6"><Button Content="Preview OOB names" Click="OobPreview_Click"/><Button Content="Apply OOB preview" Click="OobApply_Click"/></StackPanel>
          <TextBlock x:Name="OobPreviewLabel" Margin="4" TextWrapping="Wrap"/>
          <TextBlock x:Name="OobProblems" Margin="4" Foreground="#A52828" TextWrapping="Wrap"/>
          <DataGrid x:Name="OobPreviewGrid" Height="250" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns>
            <DataGridTextColumn Header="Role" Binding="{Binding Role}" IsReadOnly="True" Width="205"/>
            <DataGridTextColumn Header="Current" Binding="{Binding Before}" IsReadOnly="True" Width="185"/>
            <DataGridTextColumn Header="Proposed (editable)" Binding="{Binding After, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
          </DataGrid.Columns></DataGrid>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="DataTab" Header="Game data" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
          <TextBlock Text="BATTLEPLAN DATA MAP" FontWeight="Bold" Foreground="#254A63"/>
          <TextBlock Text="Game-provided: unit GUID, Type/SubType IDs, Country ID, OriginalName, UserTypedName, Organizational flag, and ChildGroups order. These are read from the campaign; Type labels come from the installed game's Unit_Type enum." TextWrapping="Wrap" Margin="4,10" Foreground="#415D6D"/>
          <TextBlock Text="Editor-assigned: HQ tier, branch, rename policy, command number, and naming pattern. These are stored in a per-campaign editor catalog keyed by game unit IDs. Review proposed names in Army naming. No separate equipment ID was present in the sampled campaign units." TextWrapping="Wrap" Margin="4,0,4,14" Foreground="#415D6D"/>
          <TextBlock Text="Type IDs in this campaign" FontWeight="SemiBold" Margin="4,0,4,6"/>
          <DataGrid x:Name="TypeSummaryGrid" Height="350" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"><DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
            <DataGridTextColumn Header="Game type" Binding="{Binding GameType}" Width="230"/>
            <DataGridTextColumn Header="Units" Binding="{Binding Count}" Width="65"/>
            <DataGridTextColumn Header="Editor suffix" Binding="{Binding EditorDefault}" Width="110"/>
            <DataGridTextColumn Header="Example" Binding="{Binding Example}" Width="200"/>
          </DataGrid.Columns></DataGrid>
          <TextBlock Text="Type 11 means headquarters, with no guaranteed tier. The sampled save does not store the game's CommandType enum on each unit. Assign HQ tiers in the OOB tree or Advanced naming; OriginalName is never used to choose a tier or infer a naming scheme." TextWrapping="Wrap" Margin="4,12" Foreground="#415D6D"/>
          <TextBlock Text="The top-level organizational wrapper has zero elements and is hidden from the OOB tree. Its child is the first visible army command; the wrapper remains in the campaign file." TextWrapping="Wrap" Margin="4,4" Foreground="#415D6D"/>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="FindTab" Header="Find / replace" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
          <TextBlock Text="BATCH RENAME" FontWeight="Bold" Foreground="#254A63"/>
          <TextBlock Text="Scope" Margin="4,12,4,2"/><ComboBox x:Name="ScopeBox" SelectedIndex="0"><ComboBoxItem Content="All units"/><ComboBoxItem Content="Selected unit and descendants"/><ComboBoxItem Content="Selected unit only"/></ComboBox>
          <TextBlock Text="Name contains (optional)"/><TextBox x:Name="FilterBox"/>
          <TextBlock Text="Type ID (optional)"/><TextBox x:Name="TypeBox" ToolTip="Battleplan numeric Type field"/>
          <TextBlock Text="Country ID (optional)"/><TextBox x:Name="CountryBox" ToolTip="Battleplan numeric Country field; US is 2 in this game build"/>
          <StackPanel Orientation="Horizontal"><CheckBox x:Name="OnlyUnnamedBox" Content="Only units without a user name"/><CheckBox x:Name="OnlyLeavesBox" Content="Only units without children"/></StackPanel>
          <TextBlock Text="Find (empty to replace whole name)"/><TextBox x:Name="FindBox"/>
          <StackPanel Orientation="Horizontal"><CheckBox x:Name="RegexModeBox" Content="Regex find ($1 groups in replacement)"/><CheckBox x:Name="CaseSensitiveBox" Content="Case sensitive"/></StackPanel>
          <TextBlock Text="Replace / naming template"/><TextBox x:Name="ReplaceBox" ToolTip="Tokens: {n}, {name}, {original}, {type}, {parent}"/>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Starting number" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="StartBox" Text="1" Width="76"/><TextBlock Text="Step" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="StepBox" Text="1" Width="76"/></StackPanel>
          <TextBlock Text="Tokens: {n} sequential number, {name} current displayed name, {original} generated name, {type} numeric type, {parent} parent name." TextWrapping="Wrap" Margin="4,8" Foreground="#415D6D"/>
          <StackPanel Orientation="Horizontal"><Button Content="Preview changes" Click="Preview_Click"/><Button Content="Apply preview" Click="ApplyBatch_Click"/></StackPanel>
          <TextBlock x:Name="PreviewLabel" Margin="4,8"/>
          <DataGrid x:Name="PreviewGrid" Height="270" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Current" Binding="{Binding Before}" Width="300"/><DataGridTextColumn Header="Proposed" Binding="{Binding After}" Width="300"/></DataGrid.Columns></DataGrid>
        </StackPanel></ScrollViewer></TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
